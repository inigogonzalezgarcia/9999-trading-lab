# Copy to .env and adjust. All values optional.
FXLAB_DB=data/fxlab.sqlite3          # SQLite run history
FXLAB_MAX_UPLOAD_MB=250              # reject larger uploads with HTTP 413 (use the CLI instead)
FXLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FXLAB_JOB_WORKERS=2                  # concurrent background backtests
FXLAB_LOG_LEVEL=INFO
FXLAB_STATIC_DIR=frontend/dist       # serve the built UI from the API process when present
GIT_COMMIT=                          # recorded in reproducibility metadata when set
